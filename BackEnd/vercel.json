{
    "version": 2,
    "builds": [
        {
            "src": "index.js",
            "use": "@vercel/node",
            "config": {
                "includeFiles": [
                    "config/**",
                    "controller/**",
                    "middleware/**",
                    "models/**",
                    "repository/**",
                    "routes/**",
                    "services/**",
                    "validations/**",
                    "utils/**",
                    "errors/**",
                    "serializer/**",
                    "Dtos/**"
                ]
            }
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "index.js"
        }
    ]
}