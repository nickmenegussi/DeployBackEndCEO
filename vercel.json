{
    "version": 2,
    "builds": [
        {
            "src": "BackEnd/index.js",
            "use": "@vercel/node",
            "config": {
                "includeFiles": [
                    "BackEnd/config/**",
                    "BackEnd/controller/**",
                    "BackEnd/middleware/**",
                    "BackEnd/models/**",
                    "BackEnd/repository/**",
                    "BackEnd/routes/**",
                    "BackEnd/services/**",
                    "BackEnd/validations/**",
                    "BackEnd/utils/**",
                    "BackEnd/errors/**",
                    "BackEnd/serializer/**",
                    "BackEnd/Dtos/**"
                ]
            }
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "BackEnd/index.js"
        }
    ]
}